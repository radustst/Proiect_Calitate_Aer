# Toate API-urile folosite sunt GRATUITE și NU necesită cheie API (Open-Meteo)

# PM2.5 - Open-Meteo Air Quality API (date Copernicus CAMS)
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Meteo - Open-Meteo Weather API (istoric, curent, prognoză)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Căutare coordonate oraș - Open-Meteo Geocoding API
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Default location
DEFAULT_CITY=Bucharest
DEFAULT_COUNTRY=RO
DEFAULT_LAT=44.4268
DEFAULT_LON=26.1025
